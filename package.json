{
  "name": "schedulepin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "extension:build": "npm run build",
    "helper:build": "cargo build --release --manifest-path src-tauri/Cargo.toml",
