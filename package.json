{
  "name": "schedulepin",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "extension:build": "npm run build",
    "helper:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/helper.ps1 build",
    "helper:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/helper.ps1 test",
    "helper:smoke": "node scripts/test-native-host.mjs",
    "helper:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-helper.ps1",
    "helper:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-helper.ps1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
