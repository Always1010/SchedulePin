{
  "manifest_version": 3,
  "name": "SchedulePin",
  "description": "在新标签页快速访问网站与管理计划，并可选同步为 Windows 桌面计划壁纸。",
  "version": "0.3.0",
  "key": "",
  "permissions": ["storage", "sidePanel", "nativeMessaging", "alarms", "favicon"],
  "host_permissions": ["https://commons.wikimedia.org/*", "https://upload.wikimedia.org/*", "https://thumb.wikimedia.org/*"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "side_panel": {
    "default_path": "index.html?view=sidepanel"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "打开 SchedulePin 侧边栏",
    "default_icon": {
      "32": "icons/32x32.png",
      "128": "icons/128x128.png"
    }
  },
  "icons": {
    "32": "icons/32x32.png",
    "128": "icons/128x128.png"
  }
}
